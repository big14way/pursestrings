# Copy to .env and fill in. Everything is optional: without values PurseStrings
# runs SERV in mock mode and Kite Passport in the built-in simulator.

# SERV Reasoning key from console.openserv.ai
SERV_API_KEY=

# auto | live | mock (auto = live when SERV_API_KEY is set)
SERV_MODE=auto
# Payment decisions; -serv-kronos audits the reasoning prompt
SERV_PLANNER_MODEL=claude-sonnet-5-serv-kronos
# One-sentence explanations and health probes
SERV_FAST_MODEL=claude-haiku-4.5
# 0 disables the local response cache in .pursestrings/serv-cache
SERV_CACHE=1

# auto | live | sim (auto = live when the kpass CLI is installed)
KPASS_MODE=auto
# Optional explicit path to the kpass binary
KPASS_BIN=
# Passport backend. The dev backend is the testnet one: its faucet works and its
# reference merchant settles on Kite testnet. Leave empty for kpass's production default.
KPASS_BASE_URL=https://passport.dev.gokite.ai
